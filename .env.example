# Copy this file to ".env" and fill in your real key. Never commit ".env" to GitHub.

# Get a free key (no credit card required) at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for generation.
# Gemini 2.5 Flash is used because Google's free tier (via Google AI Studio)
# requires no credit card and no payment -- ideal for a $0-budget portfolio
# project. Quality is strong for a RAG use case like this one.
GEMINI_MODEL=gemini-2.5-flash

# Embedding model (runs locally, free, no API key needed)
EMBEDDING_MODEL=gemini-embedding-001
# Where the vector database is stored on disk
CHROMA_PERSIST_DIR=./chroma_db

# Folder containing the source documents to ingest
DATA_DIR=./sample_data

# Retrieval settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RESULTS=4
